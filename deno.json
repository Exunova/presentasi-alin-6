{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env server.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --watch server.ts"
  },
  "deploy": {
    "runtime": {
      "type": "static",
      "cwd": "./public"
    },
    "org": "symful",
    "app": "present-alin"
  },
  "imports": {
    "@std/http": "jsr:@std/http@1",
    "@std/path": "jsr:@std/path@1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "exclude": ["public"]
  }
}


